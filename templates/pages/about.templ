package pages

import (
	"spaeth-construction/pkg/meta"
	"spaeth-construction/templates/layouts"
)

templ About() {
	@layouts.Base(meta.New(
		"About Us",
		"Learn about Cloverbelt Construction LLC - A licensed, bonded, and insured construction company serving Cadott, Wisconsin since 2001.",
	)) {
		@PageHeader("About Us", "Building Trust Since", "2001", "A licensed, bonded, and insured construction company proudly serving Cadott, Wisconsin and the surrounding communities.", "/images/gallery/workers-site.jpg")
		@AboutStory()
		@AboutValues()
		@AboutTimeline()
		@AboutCTA()
	}
}

templ PageHeader(badge, title, highlight, description, bgImage string) {
	<section class="relative min-h-[50vh] flex items-center overflow-hidden pt-24">
		// Background
		<div class="absolute inset-0">
			<img
				src={ bgImage }
				alt="Background"
				class="w-full h-full object-cover"
			/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-gray-900/95 via-gray-900/90 to-gray-900/80"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-transparent to-gray-900/40"></div>
		// Content
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 w-full">
			<div class="max-w-3xl">
				<div class="flex items-center gap-3 mb-6">
					<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-400"></div>
					<span class="text-green-400 text-sm font-semibold tracking-wider uppercase">
						{ badge }
					</span>
				</div>
				<h1 class="font-poppins text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-[1.1]">
					{ title }
					<span class="block text-transparent bg-clip-text bg-gradient-to-r from-green-400 via-green-500 to-emerald-400">
						{ highlight }
					</span>
				</h1>
				<p class="text-lg lg:text-xl text-white/80 max-w-xl leading-relaxed">
					{ description }
				</p>
			</div>
		</div>
	</section>
}

templ AboutStory() {
	<section class="relative py-16 lg:py-24 xl:py-32 bg-[#0a0a0a] overflow-hidden">
		<div class="absolute inset-0 construction-grid opacity-30"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				// Content
				<div>
					<div class="flex items-center gap-3 mb-4">
						<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-500"></div>
						<span class="text-green-500 text-sm font-semibold uppercase tracking-wider">
							Our Story
						</span>
					</div>
					<h2 class="font-poppins text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-6">
						Quality Construction, Honest Service
					</h2>
					<p class="text-white/60 leading-relaxed mb-6 xl:text-lg">
						Cloverbelt Construction LLC was founded by Josh R. Spaeth with a simple mission: to provide quality construction services with honesty and integrity. What started as a small residential construction company has grown into a full-service construction firm serving the entire Chippewa Valley region.
					</p>
					<p class="text-white/60 leading-relaxed mb-8 xl:text-lg">
						We've built our reputation on quality craftsmanship, honest communication, and customer satisfaction. From residential homes to commercial buildings and agricultural facilities, we bring the same dedication and expertise to every project.
					</p>
					// Stats
					<div class="grid grid-cols-2 gap-6">
						@aboutStat("20+", "Years Experience")
						@aboutStat("500+", "Projects Completed")
						@aboutStat("A+", "BBB Rating")
						@aboutStat("100%", "Satisfaction")
					</div>
				</div>
				// Image
				<div class="relative">
					<div class="relative aspect-[4/3] overflow-hidden rounded-lg shadow-xl">
						<img
							src="/images/gallery/team-planning.jpg"
							alt="Cloverbelt Construction team"
							class="w-full h-full object-cover"
						/>
						<div class="absolute inset-0 bg-gradient-to-tr from-green-600/30 to-transparent"></div>
					</div>
					<div class="absolute -bottom-6 -left-6 w-24 h-24 border-2 border-green-500/30 hidden lg:block"></div>
					<div class="absolute -top-6 -right-6 w-32 h-32 border border-white/5 hidden lg:block"></div>
				</div>
			</div>
		</div>
	</section>
}

templ aboutStat(value, label string) {
	<div class="p-4 border border-green-600/20 bg-[#111111] rounded-lg shadow-lg shadow-green-600/20">
		<div class="font-poppins text-2xl font-bold text-green-400">
			{ value }
		</div>
		<div class="text-white/50 text-sm uppercase tracking-wider">
			{ label }
		</div>
	</div>
}

templ AboutValues() {
	<section class="relative py-16 lg:py-24 xl:py-32 bg-[#111111]">
		<div class="absolute inset-0 blueprint-grid opacity-20"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12 lg:mb-16">
				<div class="flex items-center justify-center gap-3 mb-4">
					<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-500"></div>
					<span class="text-green-500 text-sm font-semibold uppercase tracking-wider">
						Our Values
					</span>
					<div class="w-12 h-[3px] bg-gradient-to-l from-green-600 to-green-500"></div>
				</div>
				<h2 class="font-poppins text-3xl lg:text-4xl font-bold text-white">
					What Sets Us Apart
				</h2>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">
				@valueCard("Quality First", "Every project receives our full commitment to excellence.", "quality")
				@valueCard("On-Time Delivery", "We respect your timeline and deliver projects on schedule.", "time")
				@valueCard("Fair Pricing", "Transparent, competitive pricing with no hidden costs.", "pricing")
				@valueCard("Expert Team", "Skilled professionals dedicated to superior standards.", "team")
			</div>
		</div>
	</section>
}

templ valueCard(title, description, iconType string) {
	<div class="group p-6 xl:p-8 bg-[#0a0a0a] border border-green-600/20 hover:border-green-500/40 transition-all duration-300 text-center rounded-lg shadow-lg shadow-green-600/20">
		<div class="w-12 h-12 xl:w-14 xl:h-14 mx-auto flex items-center justify-center border border-green-500/30 text-green-400 mb-4 group-hover:bg-green-600 group-hover:text-white group-hover:border-green-600 transition-all duration-300">
			@valueIcon(iconType)
		</div>
		<h3 class="font-poppins font-semibold text-white mb-2 xl:text-lg group-hover:text-green-400 transition-colors">
			{ title }
		</h3>
		<p class="text-white/50 text-sm xl:text-base">{ description }</p>
	</div>
}

templ valueIcon(iconType string) {
	switch iconType {
		case "quality":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"></path>
			</svg>
		case "time":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "pricing":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
			</svg>
		default:
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"></path>
			</svg>
	}
}

templ AboutTimeline() {
	<section class="relative py-16 lg:py-24 xl:py-32 bg-[#0a0a0a]">
		<div class="absolute inset-0 construction-grid opacity-30"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12 lg:mb-16">
				<div class="flex items-center justify-center gap-3 mb-4">
					<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-500"></div>
					<span class="text-green-500 text-sm font-semibold uppercase tracking-wider">
						Our Journey
					</span>
					<div class="w-12 h-[3px] bg-gradient-to-l from-green-600 to-green-500"></div>
				</div>
				<h2 class="font-poppins text-3xl lg:text-4xl font-bold text-white">
					Key Milestones
				</h2>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 xl:gap-8">
				@milestoneCard("2001", "Company Founded", "Started operations in Cadott, WI")
				@milestoneCard("2003", "LLC Established", "Incorporated as Cloverbelt Construction LLC")
				@milestoneCard("2010", "Service Expansion", "Expanded to commercial and agricultural")
				@milestoneCard("2015", "Equipment Upgrade", "Major investment in modern equipment")
				@milestoneCard("2020", "Team Growth", "Expanded team across the Chippewa Valley")
				@milestoneCard("2024", "A+ BBB Rating", "Recognized for exceptional service")
			</div>
		</div>
	</section>
}

templ milestoneCard(year, event, description string) {
	<div class="group p-6 xl:p-8 bg-[#111111] border border-green-600/20 hover:border-green-500/40 transition-all duration-300 rounded-lg shadow-lg shadow-green-600/20">
		<div class="flex items-start gap-4">
			<div class="w-14 h-14 xl:w-16 xl:h-16 flex items-center justify-center border border-green-500/30 flex-shrink-0 group-hover:bg-green-600 group-hover:border-green-600 transition-all duration-300">
				<span class="font-poppins text-sm xl:text-base font-bold text-green-400 group-hover:text-white transition-colors">
					{ year }
				</span>
			</div>
			<div>
				<h3 class="font-poppins font-semibold text-white mb-1 xl:text-lg group-hover:text-green-400 transition-colors">
					{ event }
				</h3>
				<p class="text-white/50 text-sm xl:text-base">{ description }</p>
			</div>
		</div>
	</div>
}

templ AboutCTA() {
	<section class="relative py-16 lg:py-24 xl:py-32 bg-green-600 overflow-hidden">
		<div class="absolute inset-0 construction-stripes opacity-20"></div>
		<div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="font-poppins text-2xl lg:text-4xl xl:text-5xl font-bold text-white mb-6">
				Let's Build Something Great Together
			</h2>
			<p class="text-white/90 mb-8 lg:mb-10 max-w-2xl mx-auto text-lg xl:text-xl">
				Ready to start your next project? Contact us for a free consultation and estimate.
			</p>
			<a
				href="/contact"
				class="inline-flex items-center gap-2 px-8 py-4 lg:px-10 lg:py-5 xl:px-12 xl:py-6 bg-white text-green-700 text-base lg:text-lg font-bold hover:bg-green-50 transition-colors shadow-xl rounded group"
			>
				Get Free Estimate
				<svg class="w-5 h-5 lg:w-6 lg:h-6 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
				</svg>
			</a>
		</div>
	</section>
}
