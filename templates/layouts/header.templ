package layouts

templ Header() {
	<header
		class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm transition-all duration-300"
		x-data="{ isScrolled: false, isMobileMenuOpen: false }"
		x-init="window.addEventListener('scroll', () => { isScrolled = window.scrollY > 20 })"
		:class="{ 'shadow-lg bg-white': isScrolled }"
	>
		// Top Contact Bar
		<div
			class="hidden lg:block transition-all duration-300 overflow-hidden"
			:class="{ 'max-h-0 opacity-0': isScrolled, 'max-h-12 opacity-100': !isScrolled }"
		>
			<div class="bg-green-600 text-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex items-center justify-between h-10 text-sm">
						<div class="flex items-center gap-6">
							<a href="tel:+17152894098" class="flex items-center gap-2 hover:text-green-200 transition-colors">
								<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
								</svg>
								(715) 289-4098
							</a>
							<span class="flex items-center gap-2">
								<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
								</svg>
								Cadott, WI
							</span>
						</div>
						<div class="flex items-center gap-4">
							<span class="text-green-200">Licensed & Insured | A+ BBB Rated</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		// Main Navigation
		<div class="border-b border-gray-100">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16 lg:h-20">
					// Logo
					<a href="/" class="flex items-center gap-3 group">
						<div class="relative w-10 h-10 lg:w-12 lg:h-12">
							@Logo()
						</div>
						<div class="flex flex-col">
							<span class="font-poppins font-bold text-lg lg:text-xl text-gray-900 tracking-tight group-hover:text-green-600 transition-colors">
								CLOVERBELT
							</span>
							<span class="text-[10px] lg:text-xs text-green-600 tracking-[0.2em] uppercase font-medium">
								Construction LLC
							</span>
						</div>
					</a>
					// Desktop Navigation
					<nav class="hidden lg:flex items-center gap-1">
						@navLink("/", "Home")
						@navLink("/services", "Services")
						@navLink("/projects", "Projects")
						@navLink("/about", "About")
						@navLink("/contact", "Contact")
						<a
							href="/contact"
							class="ml-4 px-6 py-2.5 xl:px-8 xl:py-3 bg-green-600 text-white text-sm xl:text-base font-semibold hover:bg-green-500 transition-all duration-300 shadow-md shadow-green-600/20 rounded"
						>
							Free Estimate
						</a>
					</nav>
					// Mobile: Phone + Menu
					<div class="lg:hidden flex items-center gap-3">
						<a
							href="tel:+17152894098"
							class="p-2 text-green-600 hover:text-green-500 transition-colors"
							aria-label="Call us"
						>
							<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
							</svg>
						</a>
						<button
							@click="isMobileMenuOpen = !isMobileMenuOpen"
							class="p-2 text-gray-700"
							aria-label="Toggle menu"
						>
							<div class="w-6 h-5 relative flex flex-col justify-between">
								<span
									class="w-full h-0.5 bg-current transform transition-all duration-300 origin-center"
									:class="{ 'rotate-45 translate-y-2': isMobileMenuOpen }"
								></span>
								<span
									class="w-full h-0.5 bg-current transition-all duration-300"
									:class="{ 'opacity-0': isMobileMenuOpen }"
								></span>
								<span
									class="w-full h-0.5 bg-current transform transition-all duration-300 origin-center"
									:class="{ '-rotate-45 -translate-y-2': isMobileMenuOpen }"
								></span>
							</div>
						</button>
					</div>
				</div>
			</div>
		</div>
		// Mobile Menu
		<div
			class="lg:hidden transition-all duration-300 overflow-hidden"
			:class="{ 'max-h-[500px] opacity-100': isMobileMenuOpen, 'max-h-0 opacity-0': !isMobileMenuOpen }"
		>
			<nav class="bg-white border-t border-gray-100 px-4 py-4 shadow-lg">
				@mobileNavLink("/", "Home")
				@mobileNavLink("/services", "Services")
				@mobileNavLink("/projects", "Projects")
				@mobileNavLink("/about", "About")
				@mobileNavLink("/contact", "Contact")
				<div class="mt-4 mx-4 pt-4 border-t border-gray-100">
					<a
						href="/contact"
						class="block px-4 py-3 bg-green-600 text-white text-sm font-semibold text-center hover:bg-green-500 transition-all rounded"
					>
						Get Free Estimate
					</a>
					<div class="mt-4 flex items-center justify-center gap-2 text-gray-500 text-xs">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"></path>
						</svg>
						Licensed & Insured | A+ BBB Rated
					</div>
				</div>
			</nav>
		</div>
	</header>
}

templ navLink(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="relative px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors duration-300"
	>
		{ label }
	</a>
}

templ mobileNavLink(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="block px-4 py-3 text-sm font-medium border-l-2 border-transparent text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-all duration-200"
	>
		{ label }
	</a>
}

templ Logo() {
	<svg viewBox="0 0 48 48" class="w-full h-full" fill="none">
		<circle cx="18" cy="18" r="8" fill="#22c55e"></circle>
		<circle cx="30" cy="18" r="8" fill="#16a34a"></circle>
		<circle cx="18" cy="30" r="8" fill="#16a34a"></circle>
		<circle cx="30" cy="30" r="8" fill="#22c55e"></circle>
		<rect x="20" y="14" width="8" height="20" fill="#ffffff"></rect>
		<rect x="14" y="20" width="20" height="8" fill="#ffffff"></rect>
		<circle cx="24" cy="24" r="4" fill="#22c55e"></circle>
	</svg>
}
