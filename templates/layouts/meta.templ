package layouts

import "spaeth-construction/internal/meta"

templ MetaTags(m meta.PageMeta) {
	<title>{ m.Title } | { meta.SiteNameFromCtx(ctx) }</title>
	if m.Description != "" {
		<meta name="description" content={ m.Description }/>
	}
	if len(m.Keywords) > 0 {
		<meta name="keywords" content={ keywordsToString(m.Keywords) }/>
	}
	if m.Canonical != "" {
		<link rel="canonical" href={ m.Canonical }/>
	}
	if m.NoIndex {
		<meta name="robots" content="noindex, nofollow"/>
	}
	// Open Graph
	<meta property="og:title" content={ m.Title }/>
	<meta property="og:site_name" content={ meta.SiteNameFromCtx(ctx) }/>
	<meta property="og:type" content={ m.OGType }/>
	if m.Description != "" {
		<meta property="og:description" content={ m.Description }/>
	}
	if m.OGImage != "" {
		<meta property="og:image" content={ m.OGImage }/>
	} else {
		<meta property="og:image" content={ meta.DefaultOGImageFromCtx(ctx) }/>
	}
	// Twitter Card
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ m.Title }/>
	if m.Description != "" {
		<meta name="twitter:description" content={ m.Description }/>
	}
	if m.OGImage != "" {
		<meta name="twitter:image" content={ m.OGImage }/>
	} else {
		<meta name="twitter:image" content={ meta.DefaultOGImageFromCtx(ctx) }/>
	}
}

func keywordsToString(keywords []string) string {
	result := ""
	for i, k := range keywords {
		if i > 0 {
			result += ", "
		}
		result += k
	}
	return result
}
