package layouts

import "time"

templ Footer() {
	<footer class="relative bg-gray-900 overflow-hidden">
		// Top Border - Green Gradient
		<div class="h-1 bg-gradient-to-r from-green-700 via-green-500 to-green-700"></div>
		// Main Content
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 lg:pt-20 pb-8">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-12 lg:mb-16">
				// Brand Column
				<div class="lg:col-span-1">
					<a href="/" class="flex items-center gap-3 mb-6 group">
						<div class="w-10 h-10">
							@FooterLogo()
						</div>
						<div class="flex flex-col">
							<span class="font-poppins font-bold text-lg text-white group-hover:text-green-400 transition-colors">
								CLOVERBELT
							</span>
							<span class="text-[10px] text-green-500 tracking-[0.2em] uppercase">
								Construction LLC
							</span>
						</div>
					</a>
					<p class="text-gray-400 text-sm leading-relaxed mb-6">
						Building Wisconsin's future since 2001. Licensed, bonded, and insured construction services for residential, commercial, and agricultural projects.
					</p>
					// Social Links
					<div class="flex gap-3">
						<a
							href="https://www.facebook.com/people/Cloverbelt-Construction/100063839118887/"
							target="_blank"
							rel="noopener noreferrer"
							class="w-10 h-10 flex items-center justify-center border border-gray-700 text-gray-400 hover:border-green-500 hover:bg-green-500/10 hover:text-green-400 transition-all duration-300 rounded"
							aria-label="Facebook"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
							</svg>
						</a>
						<a
							href="https://x.com/cloverbeltconsn"
							target="_blank"
							rel="noopener noreferrer"
							class="w-10 h-10 flex items-center justify-center border border-gray-700 text-gray-400 hover:border-green-500 hover:bg-green-500/10 hover:text-green-400 transition-all duration-300 rounded"
							aria-label="X (Twitter)"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
							</svg>
						</a>
					</div>
				</div>
				// Services Column
				<div>
					<h4 class="font-poppins font-semibold text-white mb-4 flex items-center gap-2">
						<span class="w-8 h-[2px] bg-gradient-to-r from-green-600 to-green-500"></span>
						Services
					</h4>
					<ul class="space-y-2">
						@footerServiceLink("Commercial Construction")
						@footerServiceLink("Agricultural Buildings")
						@footerServiceLink("Residential Construction")
						@footerServiceLink("Concrete Work")
						@footerServiceLink("Excavation Services")
						@footerServiceLink("Demolition")
					</ul>
				</div>
				// Quick Links Column
				<div>
					<h4 class="font-poppins font-semibold text-white mb-4 flex items-center gap-2">
						<span class="w-8 h-[2px] bg-gradient-to-r from-green-600 to-green-500"></span>
						Company
					</h4>
					<ul class="space-y-2">
						@footerLink("/about", "About Us")
						@footerLink("/projects", "Our Projects")
						@footerLink("/services", "Services")
						@footerLink("/contact", "Contact")
					</ul>
				</div>
				// Contact Column
				<div>
					<h4 class="font-poppins font-semibold text-white mb-4 flex items-center gap-2">
						<span class="w-8 h-[2px] bg-gradient-to-r from-green-600 to-green-500"></span>
						Contact
					</h4>
					<ul class="space-y-4">
						<li>
							<a
								href="tel:+17152894098"
								class="flex items-center gap-3 text-gray-400 text-sm hover:text-green-400 transition-colors duration-300 group"
							>
								<span class="w-9 h-9 flex items-center justify-center border border-gray-700 group-hover:border-green-500 group-hover:bg-green-500/10 transition-all rounded">
									<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
									</svg>
								</span>
								(715) 289-4098
							</a>
						</li>
						<li>
							<a
								href="https://maps.google.com/?q=2515+250th+St+Cadott+WI+54727"
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-start gap-3 text-gray-400 text-sm hover:text-green-400 transition-colors duration-300 group"
							>
								<span class="w-9 h-9 flex items-center justify-center border border-gray-700 group-hover:border-green-500 group-hover:bg-green-500/10 transition-all flex-shrink-0 rounded">
									<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
										<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
									</svg>
								</span>
								<span>
									2515 250th St<br/>
									Cadott, WI 54727
								</span>
							</a>
						</li>
						<li>
							<div class="flex items-center gap-3 text-gray-400 text-sm">
								<span class="w-9 h-9 flex items-center justify-center border border-gray-700 flex-shrink-0 rounded">
									<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</span>
								Mon-Fri: 7AM - 5PM
							</div>
						</li>
					</ul>
				</div>
			</div>
			// Bottom Bar
			<div class="pt-8 border-t border-gray-800">
				<div class="flex flex-col md:flex-row justify-between items-center gap-4">
					<p class="text-gray-500 text-sm">
						© { currentYear() } Cloverbelt Construction LLC. All rights reserved.
					</p>
					<div class="flex items-center gap-4">
						<span class="text-gray-500 text-xs uppercase tracking-wider">A+ BBB Rated</span>
						<span class="text-green-500">|</span>
						<span class="text-gray-500 text-xs uppercase tracking-wider">Licensed & Insured</span>
					</div>
				</div>
			</div>
		</div>
	</footer>
}

templ footerServiceLink(label string) {
	<li>
		<a
			href="/services"
			class="text-gray-400 text-sm hover:text-green-400 transition-colors duration-300"
		>
			{ label }
		</a>
	</li>
}

templ footerLink(href, label string) {
	<li>
		<a
			href={ templ.SafeURL(href) }
			class="text-gray-400 text-sm hover:text-green-400 transition-colors duration-300"
		>
			{ label }
		</a>
	</li>
}

templ FooterLogo() {
	<svg viewBox="0 0 48 48" class="w-full h-full" fill="none">
		<circle cx="18" cy="18" r="8" fill="#22c55e"></circle>
		<circle cx="30" cy="18" r="8" fill="#16a34a"></circle>
		<circle cx="18" cy="30" r="8" fill="#16a34a"></circle>
		<circle cx="30" cy="30" r="8" fill="#22c55e"></circle>
		<rect x="20" y="14" width="8" height="20" fill="#111827"></rect>
		<rect x="14" y="20" width="20" height="8" fill="#111827"></rect>
		<circle cx="24" cy="24" r="4" fill="#22c55e"></circle>
	</svg>
}

func currentYear() string {
	return time.Now().Format("2006")
}
