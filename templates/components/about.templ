package components

type Value struct {
	IconType    string
	Title       string
	Description string
}

type Milestone struct {
	Year        string
	Event       string
	Description string
}

var values = []Value{
	{IconType: "quality", Title: "Quality First", Description: "Every project receives our full commitment to excellence and attention to detail."},
	{IconType: "time", Title: "On-Time Delivery", Description: "We respect your timeline and deliver projects on schedule, every time."},
	{IconType: "pricing", Title: "Fair Pricing", Description: "Transparent, competitive pricing with no hidden costs or surprises."},
	{IconType: "craft", Title: "Craftsmanship", Description: "Skilled professionals dedicated to superior construction standards."},
}

var milestones = []Milestone{
	{Year: "2001", Event: "Company Founded", Description: "Started operations in Cadott, WI"},
	{Year: "2003", Event: "LLC Established", Description: "Officially incorporated as Cloverbelt Construction LLC"},
	{Year: "2010", Event: "Expansion", Description: "Grew services to include commercial and agricultural"},
	{Year: "2024", Event: "A+ BBB Rating", Description: "Recognized for exceptional customer service"},
}

templ About() {
	<section
		id="about"
		class="relative py-24 lg:py-32 bg-[#0a0a0a] overflow-hidden"
	>
		<div class="absolute inset-0 construction-grid opacity-20"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-center">
				// Left content
				<div>
					<div class="flex items-center gap-3 mb-4">
						<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-500"></div>
						<span class="text-green-500 text-sm font-semibold uppercase tracking-wider">
							About Us
						</span>
					</div>
					<h2 class="font-poppins text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
						Building Trust Since
						<span class="block text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-500">2001</span>
					</h2>
					<p class="text-lg text-white/60 mb-6 leading-relaxed">
						Cloverbelt Construction LLC is a licensed, bonded, and insured construction company proudly serving Cadott, Wisconsin and the surrounding communities. Founded by Josh R. Spaeth, we've built our reputation on quality craftsmanship, honest communication, and customer satisfaction.
					</p>
					<p class="text-white/60 mb-8 leading-relaxed">
						From residential homes to commercial buildings and agricultural facilities, we bring the same dedication and expertise to every project. Our team specializes in concrete work, excavation, and full-scale construction services designed to meet the unique needs of Wisconsin property owners.
					</p>
					// Values grid
					<div class="grid sm:grid-cols-2 gap-4">
						for _, value := range values {
							@valueCard(value)
						}
					</div>
				</div>
				// Right content - Timeline
				<div>
					<div class="relative">
						// Image
						<div class="relative aspect-[4/3] overflow-hidden mb-8">
							<img
								src="/images/gallery/team-planning.jpg"
								alt="Cloverbelt Construction team"
								class="w-full h-full object-cover"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-tr from-green-600/20 to-transparent"></div>
						</div>
						// Timeline Card
						<div class="bg-[#111111] border border-green-600/20 p-8">
							<h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
								<span class="w-10 h-10 bg-green-600 flex items-center justify-center">
									<svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</span>
								Our Journey
							</h3>
							<div class="space-y-6">
								for _, milestone := range milestones {
									@milestoneItem(milestone)
								}
							</div>
							// BBB Badge
							<div class="mt-8 pt-8 border-t border-green-600/20">
								<div class="flex items-center gap-4">
									<div class="w-14 h-14 bg-white flex items-center justify-center">
										<span class="text-2xl font-black text-blue-800">BBB</span>
									</div>
									<div>
										<div class="flex items-center gap-2 mb-1">
											<span class="text-white font-semibold">A+ Rated</span>
											<div class="flex gap-0.5">
												for i := 0; i < 5; i++ {
													<svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 20 20">
														<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
													</svg>
												}
											</div>
										</div>
										<p class="text-white/50 text-sm">Better Business Bureau</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ valueCard(v Value) {
	<div class="flex items-start gap-3 p-4 bg-[#111111] border border-green-600/10 hover:border-green-500/30 transition-colors duration-300">
		<div class="w-10 h-10 flex items-center justify-center border border-green-500/30 text-green-400 flex-shrink-0">
			@valueIcon(v.IconType)
		</div>
		<div>
			<h4 class="font-semibold text-white mb-1">{ v.Title }</h4>
			<p class="text-sm text-white/50">{ v.Description }</p>
		</div>
	</div>
}

templ valueIcon(iconType string) {
	switch iconType {
		case "quality":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"></path>
			</svg>
		case "time":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "pricing":
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"></path>
			</svg>
		default:
			<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"></path>
			</svg>
	}
}

templ milestoneItem(m Milestone) {
	<div class="flex gap-4 group">
		<div class="flex-shrink-0">
			<div class="w-16 h-16 bg-green-500/10 border border-green-500/30 flex items-center justify-center group-hover:bg-green-600 group-hover:border-green-600 transition-all duration-300">
				<span class="text-sm font-bold text-green-400 group-hover:text-white transition-colors duration-300">
					{ m.Year }
				</span>
			</div>
		</div>
		<div class="flex-1 pt-1">
			<h4 class="text-lg font-semibold text-white mb-1 group-hover:text-green-400 transition-colors duration-300">
				{ m.Event }
			</h4>
			<p class="text-white/50 text-sm">{ m.Description }</p>
		</div>
	</div>
}
