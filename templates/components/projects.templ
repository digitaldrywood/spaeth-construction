package components

type Project struct {
	Category    string
	Title       string
	Description string
	Stats       []string
	Image       string
}

var projects = []Project{
	{
		Category:    "Commercial",
		Title:       "Office Complex Foundation",
		Description: "Complete foundation and concrete work for a 20,000 sq ft commercial office building.",
		Stats:       []string{"20,000 sq ft", "45 Days", "Cadott, WI"},
		Image:       "/images/construction-1.jpg",
	},
	{
		Category:    "Agricultural",
		Title:       "Dairy Barn Construction",
		Description: "Full agricultural building including structural work and specialized flooring.",
		Stats:       []string{"150 Head Capacity", "90 Days", "Chippewa Falls"},
		Image:       "/images/construction-2.jpg",
	},
	{
		Category:    "Residential",
		Title:       "Custom Home Build",
		Description: "Complete residential construction from foundation to finishing for a 3,500 sq ft home.",
		Stats:       []string{"3,500 sq ft", "6 Months", "Eau Claire"},
		Image:       "/images/construction-3.jpg",
	},
	{
		Category:    "Concrete",
		Title:       "Decorative Patio Project",
		Description: "Stamped concrete patio with custom patterns and integrated drainage system.",
		Stats:       []string{"1,200 sq ft", "2 Weeks", "Stanley, WI"},
		Image:       "/images/concrete.jpg",
	},
	{
		Category:    "Excavation",
		Title:       "Site Development",
		Description: "Land clearing and site preparation for a new residential subdivision.",
		Stats:       []string{"15 Acres", "30 Days", "Boyd, WI"},
		Image:       "/images/excavator.jpg",
	},
	{
		Category:    "Commercial",
		Title:       "Retail Expansion",
		Description: "Building expansion and parking lot construction for local retail business.",
		Stats:       []string{"8,000 sq ft", "60 Days", "Cadott, WI"},
		Image:       "/images/construction-1.jpg",
	},
}

templ Projects() {
	<section
		id="projects"
		class="relative py-24 lg:py-32 xl:py-40 bg-[#0a0a0a] overflow-hidden"
	>
		<div class="absolute inset-0 blueprint-grid opacity-20"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			// Section header
			<div class="text-center mb-12">
				<div class="flex items-center justify-center gap-3 mb-4">
					<div class="w-12 h-[3px] bg-gradient-to-r from-green-600 to-green-500"></div>
					<span class="text-green-500 text-sm font-semibold uppercase tracking-wider">
						Our Portfolio
					</span>
					<div class="w-12 h-[3px] bg-gradient-to-l from-green-600 to-green-500"></div>
				</div>
				<h2 class="font-poppins text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
					Featured
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-500"> Projects</span>
				</h2>
				<p class="text-lg text-white/60 max-w-2xl mx-auto">
					A showcase of our craftsmanship across residential, commercial, and agricultural construction.
				</p>
			</div>
			// Projects grid
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 xl:gap-8">
				for _, project := range projects {
					@projectCard(project)
				}
			</div>
			// CTA
			<div class="text-center mt-12 xl:mt-16">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 text-green-400 font-semibold text-base lg:text-lg hover:text-green-300 transition-colors duration-300 group"
				>
					View All Projects
					<svg class="w-5 h-5 lg:w-6 lg:h-6 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>
}

templ projectCard(p Project) {
	<div class="group relative overflow-hidden bg-[#111111] border border-green-600/20 hover:border-green-500/40 transition-all duration-500 rounded-lg shadow-lg shadow-green-600/20 h-full flex flex-col">
		// Project image
		<div class="relative h-56 xl:h-64 overflow-hidden flex-shrink-0">
			<img
				src={ p.Image }
				alt={ p.Title }
				class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent"></div>
			// Category badge
			<div class="absolute top-4 left-4">
				<span class="px-3 py-1 bg-green-600/90 text-white text-xs font-semibold rounded">
					{ p.Category }
				</span>
			</div>
		</div>
		// Content
		<div class="p-6 xl:p-8 flex flex-col flex-1">
			<h3 class="font-poppins text-xl xl:text-2xl font-bold text-white mb-2 group-hover:text-green-400 transition-colors duration-300">
				{ p.Title }
			</h3>
			<p class="text-white/60 text-sm xl:text-base mb-4 leading-relaxed">
				{ p.Description }
			</p>
			// Stats
			<div class="flex flex-wrap gap-2 mt-auto">
				for _, stat := range p.Stats {
					<span class="px-3 py-1 bg-green-500/10 text-green-400 text-xs border border-green-500/20 rounded">
						{ stat }
					</span>
				}
			</div>
		</div>
		// Hover line
		<div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-green-600 to-green-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
	</div>
}
